[Unit]
Description=TrainCapsule signed immutable runtime refresh broker
After=traincapsule-verifier-git-anchor-updater.service
ConditionPathExists=/etc/traincapsule-deployment/refresh-policy.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/traincapsule-deployment-refresh --apply --confirm APPLY_DEPLOYMENT_REFRESH
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/traincapsule-verifier/deployment-refresh-claims
ReadOnlyPaths=/var/lib/traincapsule-verifier/anchor-updates
ReadOnlyPaths=/var/lib/traincapsule-runtime/git
ReadWritePaths=/opt/traincapsule-runtime/generations
ReadWritePaths=/opt/traincapsule-runtime/current
ReadWritePaths=/var/lib/traincapsule-verifier/repository-boundary
ReadWritePaths=/var/lib/traincapsule-verifier/deployment-refresh-journal
ReadWritePaths=/etc/traincapsule-controller
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
UMask=0077
