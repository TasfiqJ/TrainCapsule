    "workItemId": {
      "pattern": "^V3-[A-Z]+-[0-9]{3}$",
      "title": "Workitemid",
      "type": "string"
    },
    "traincheckToolDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trainchecktooldigest",
