{
  "$defs": {
    "CommercialCeiling": {
      "enum": [
        "NOT_EVALUATED",
        "NATIVE_ADVANTAGE_UNPROVEN",
        "PILOT_ELIGIBLE",
        "COMMERCIALLY_SUPPORTED",
        "WITHDRAWN"
      ],
      "title": "CommercialCeiling",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EngineeringCeiling": {
      "enum": [
        "NOT_EVALUATED",
        "FAILED",
        "PASSED"
      ],
      "title": "EngineeringCeiling",
      "type": "string"
    },
    "GitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "NativeDisposition": {
      "enum": [
        "NATIVE_SUFFICIENT",
        "INCREMENTAL_VALUE",
        "NOT_COMPARABLE",
        "UNKNOWN"
      ],
      "title": "NativeDisposition",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^/].*$",
      "type": "string"
    },
    "SourceGenerationId": {
      "maxLength": 128,
      "minLength": 3,
      "type": "string"
    },
    "ValueDisposition": {
      "enum": [
        "NATIVE_WORKFLOW_SUFFICIENT",
        "NO_INCREMENTAL_DECISION_VALUE",
        "TECHNICALLY_VALID_BUT_NOT_ECONOMIC",
        "INCREMENTAL_DECISION_VALUE_DEMONSTRATED",
        "EXTERNAL_EVIDENCE_REQUIRED",
        "UNKNOWN"
      ],
      "title": "ValueDisposition",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/verifier/v3.1/verification-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseSha": {
      "$ref": "#/$defs/GitSha"
    },
    "candidateManifestDigest": {
      "$ref": "#/$defs/Digest"
    },
    "candidateSha": {
      "$ref": "#/$defs/GitSha"
    },
    "candidateTreeSha": {
      "$ref": "#/$defs/GitSha"
    },
    "checkpointDigest": {
      "$ref": "#/$defs/Digest"
    },
    "commercialMaturityCeiling": {
      "$ref": "#/$defs/CommercialCeiling"
    },
    "contextManifestDigest": {
      "$ref": "#/$defs/Digest"
    },
    "decisionValueDisposition": {
      "$ref": "#/$defs/ValueDisposition"
    },
    "engineeringMaturityCeiling": {
      "$ref": "#/$defs/EngineeringCeiling"
    },
    "lane": {
      "$ref": "#/$defs/Identifier"
    },
    "milestoneId": {
      "pattern": "^M[0-9]+_[A-Z0-9_]+$",
      "title": "Milestoneid",
      "type": "string"
    },
    "nativeSubstituteDisposition": {
      "$ref": "#/$defs/NativeDisposition"
    },
    "nonce": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Nonce",
      "type": "string"
    },
    "publicationScope": {
      "items": {
        "$ref": "#/$defs/RelativePath"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Publicationscope",
      "type": "array"
    },
    "requestDigest": {
      "$ref": "#/$defs/Digest"
    },
    "requestId": {
      "$ref": "#/$defs/Identifier"
    },
    "requestedClaims": {
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Requestedclaims",
      "type": "array"
    },
    "riskTier": {
      "$ref": "#/$defs/Identifier"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceGenerationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "sourceGenerationId": {
      "$ref": "#/$defs/SourceGenerationId"
    },
    "taskPacketDigest": {
      "$ref": "#/$defs/Digest"
    },
    "workItemId": {
      "pattern": "^V3-[A-Z]+-[0-9]{3}$",
      "title": "Workitemid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "requestDigest",
    "nonce",
    "workItemId",
    "milestoneId",
    "lane",
    "riskTier",
    "candidateSha",
    "candidateTreeSha",
    "baseSha",
    "sourceGenerationId",
    "sourceGenerationDigest",
    "contextManifestDigest",
    "taskPacketDigest",
    "candidateManifestDigest",
    "checkpointDigest",
    "requestedClaims",
    "publicationScope",
    "nativeSubstituteDisposition",
    "decisionValueDisposition",
    "engineeringMaturityCeiling",
    "commercialMaturityCeiling"
  ],
  "title": "VerificationRequest",
  "type": "object"
}
