{
  "$defs": {
    "AccountEvidenceField": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
          "title": "Claimid",
          "type": "string"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceArtifactDigests": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Sourceartifactdigests",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "verdict": {
          "$ref": "#/$defs/ResearchVerdict"
        }
      },
      "required": [
        "schemaVersion",
        "verdict",
        "claimId"
      ],
      "title": "AccountEvidenceField",
      "type": "object"
    },
    "AccountQualificationScore": {
      "additionalProperties": false,
      "properties": {
        "budgetOwner": {
          "maximum": 3,
          "minimum": 0,
          "title": "Budgetowner",
          "type": "integer"
        },
        "deliveryFit": {
          "maximum": 3,
          "minimum": 0,
          "title": "Deliveryfit",
          "type": "integer"
        },
        "evidenceAccess": {
          "maximum": 3,
          "minimum": 0,
          "title": "Evidenceaccess",
          "type": "integer"
        },
        "experimentAuthority": {
          "maximum": 3,
          "minimum": 0,
          "title": "Experimentauthority",
          "type": "integer"
        },
        "incidentCost": {
          "maximum": 3,
          "minimum": 0,
          "title": "Incidentcost",
          "type": "integer"
        },
        "nativeGap": {
          "maximum": 3,
          "minimum": 0,
          "title": "Nativegap",
          "type": "integer"
        },
        "privacyNeed": {
          "maximum": 3,
          "minimum": 0,
          "title": "Privacyneed",
          "type": "integer"
        },
        "repeatTrigger": {
          "maximum": 3,
          "minimum": 0,
          "title": "Repeattrigger",
          "type": "integer"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "secondUsePath": {
          "maximum": 3,
          "minimum": 0,
          "title": "Secondusepath",
          "type": "integer"
        },
        "total": {
          "maximum": 30,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "upcomingChange": {
          "maximum": 3,
          "minimum": 0,
          "title": "Upcomingchange",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "incidentCost",
        "upcomingChange",
        "evidenceAccess",
        "experimentAuthority",
        "nativeGap",
        "privacyNeed",
        "repeatTrigger",
        "budgetOwner",
        "secondUsePath",
        "deliveryFit",
        "total"
      ],
      "title": "AccountQualificationScore",
      "type": "object"
    },
    "AccountResearchState": {
      "enum": [
        "RESEARCH_ONLY",
        "EXTERNAL_EVIDENCE_REQUIRED",
        "CONFLICT"
      ],
      "title": "AccountResearchState",
      "type": "string"
    },
    "ReachableAccount": {
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "pattern": "^ACCOUNT-[0-9]{3}$",
          "title": "Accountid",
          "type": "string"
        },
        "budgetOwner": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "decisionOwner": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "knownIncident": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "nativeStack": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "nextEvidenceAction": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Nextevidenceaction",
          "type": "string"
        },
        "organization": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "plannedChange": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "privacyConstraint": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "qualificationScore": {
          "$ref": "#/$defs/AccountQualificationScore"
        },
        "relationshipPath": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "relevantWorkload": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "segment": {
          "$ref": "#/$defs/AccountEvidenceField"
        },
        "state": {
          "$ref": "#/$defs/AccountResearchState"
        },
        "technicalChampion": {
          "$ref": "#/$defs/AccountEvidenceField"
        }
      },
      "required": [
        "schemaVersion",
        "accountId",
        "organization",
        "segment",
        "relationshipPath",
        "relevantWorkload",
        "knownIncident",
        "plannedChange",
        "decisionOwner",
        "technicalChampion",
        "budgetOwner",
        "nativeStack",
        "privacyConstraint",
        "qualificationScore",
        "nextEvidenceAction",
        "state"
      ],
      "title": "ReachableAccount",
      "type": "object"
    },
    "ResearchVerdict": {
      "enum": [
        "CLEAR",
        "CONFLICT",
        "UNKNOWN"
      ],
      "title": "ResearchVerdict",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/reachable-account-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/$defs/ReachableAccount"
      },
      "maxItems": 30,
      "minItems": 30,
      "title": "Accounts",
      "type": "array"
    },
    "candidateSha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidatesha",
      "type": "string"
    },
    "claimIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Claimids",
      "type": "array"
    },
    "externalOutcomesDemonstrated": {
      "default": false,
      "title": "Externaloutcomesdemonstrated",
      "type": "boolean"
    },
    "mapId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Mapid",
      "type": "string"
    },
    "rawSourceArtifactDigests": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Rawsourceartifactdigests",
      "type": "array"
    },
    "researchReportDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Researchreportdigest",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "workItemId": {
      "pattern": "^V3-[A-Z]+-[0-9]{3}$",
      "title": "Workitemid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "mapId",
    "workItemId",
    "candidateSha",
    "researchReportDigest",
    "accounts",
    "claimIds",
    "rawSourceArtifactDigests"
  ],
  "title": "ReachableAccountMap",
  "type": "object"
}
