{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "REJECTED"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalReviewer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "organization": {
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName",
        "organization"
      ],
      "title": "ApprovalReviewer",
      "type": "object"
    },
    "ApprovalScope": {
      "enum": [
        "SOURCE_OF_TRUTH_MIGRATION",
        "EXTERNAL_RELEASE",
        "COMMERCIAL_PACK_RELEASE",
        "TRUST_CORE_CHANGE",
        "SECURITY_BOUNDARY_CHANGE",
        "CUSTOMER_CLAIM",
        "ROADMAP_EXPANSION",
        "WEDGE_DECISION"
      ],
      "title": "ApprovalScope",
      "type": "string"
    },
    "ApprovalSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/SignatureAlgorithm"
        },
        "keyId": {
          "minLength": 1,
          "title": "Keyid",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "title": "ApprovalSignature",
      "type": "object"
    },
    "SignatureAlgorithm": {
      "enum": [
        "ed25519",
        "external-trusted-root"
      ],
      "title": "SignatureAlgorithm",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "approvalId": {
      "pattern": "^HAPR-[A-Z0-9_-]+$",
      "title": "Approvalid",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ApprovalScope"
    },
    "candidateCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidatecommit",
      "type": "string"
    },
    "artifactDigests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Artifactdigests",
      "type": "object"
    },
    "reviewer": {
      "$ref": "#/$defs/ApprovalReviewer"
    },
    "reviewerQualification": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewerqualification",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "conditions": {
      "items": {
        "type": "string"
      },
      "title": "Conditions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "issuedAt": {
      "format": "date-time",
      "title": "Issuedat",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expiresat"
    },
    "signature": {
      "$ref": "#/$defs/ApprovalSignature"
    },
    "syntheticTestOnly": {
      "const": false,
      "default": false,
      "title": "Synthetictestonly",
      "type": "boolean"
    }
  },
  "required": [
    "approvalId",
    "scope",
    "candidateCommit",
    "artifactDigests",
    "reviewer",
    "reviewerQualification",
    "decision",
    "conditions",
    "limitations",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "title": "HumanApprovalRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/human-approval.schema.json"
}
