{
  "$defs": {
    "EligibilityOutcome": {
      "enum": [
        "ELIGIBLE_FOR_QUALIFICATION",
        "NEEDS_MORE_EVIDENCE",
        "NATIVE_WORKFLOW_SUFFICIENT",
        "TECHNICALLY_POSSIBLE_BUT_UNECONOMIC",
        "OUTSIDE_SUPPORTED_ENVELOPE",
        "POLICY_BLOCKED",
        "UNKNOWN"
      ],
      "title": "EligibilityOutcome",
      "type": "string"
    },
    "ExperimentEconomics": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "estimatedCost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcost"
        },
        "estimatedDurationSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimateddurationseconds"
        }
      },
      "required": [
        "basis"
      ],
      "title": "ExperimentEconomics",
      "type": "object"
    },
    "IdentityStrength": {
      "enum": [
        "FULLY_VERIFIED",
        "PARTIALLY_VERIFIED",
        "CUSTOMER_ATTESTED",
        "UNVERIFIED",
        "CONFLICTING"
      ],
      "title": "IdentityStrength",
      "type": "string"
    },
    "MachineVerification": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/VerificationOutcome"
        },
        "policy": {
          "$ref": "#/$defs/PolicyName"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "subjectDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Subjectdigest",
          "type": "string"
        },
        "verifier": {
          "const": "traincapsule-deterministic-policy",
          "default": "traincapsule-deterministic-policy",
          "title": "Verifier",
          "type": "string"
        },
        "verifierVersion": {
          "const": "1",
          "default": "1",
          "title": "Verifierversion",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "outcome",
        "subjectDigest",
        "reason"
      ],
      "title": "MachineVerification",
      "type": "object"
    },
    "OperationalDecision": {
      "enum": [
        "APPROVE_WITHIN_ENVELOPE",
        "BLOCK_CHANGE",
        "REQUIRE_MORE_EVIDENCE",
        "NO_DECISION",
        "NATIVE_WORKFLOW_SUFFICIENT",
        "TECHNICALLY_VALID_BUT_NOT_ECONOMIC"
      ],
      "title": "OperationalDecision",
      "type": "string"
    },
    "PolicyName": {
      "enum": [
        "PACK_FIT",
        "LOCAL_EXECUTION_AUTHORITY",
        "PRIVACY_POLICY",
        "EXPORT_POLICY",
        "SOURCE_VERSION",
        "ECONOMICS"
      ],
      "title": "PolicyName",
      "type": "string"
    },
    "TechnicalResult": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "INVALID_EVIDENCE",
        "INVALID_ORACLE",
        "INFRASTRUCTURE_ERROR",
        "POLICY_BLOCKED",
        "EXPIRED"
      ],
      "title": "TechnicalResult",
      "type": "string"
    },
    "VerificationOutcome": {
      "enum": [
        "VERIFIED",
        "DENIED",
        "UNKNOWN"
      ],
      "title": "VerificationOutcome",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselineEnvironmentId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baselineenvironmentid",
      "type": "string"
    },
    "candidateEnvironmentId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidateenvironmentid",
      "type": "string"
    },
    "caseId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Caseid",
      "type": "string"
    },
    "evidenceRefs": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidencerefs",
      "type": "array"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "identityStrength": {
      "$ref": "#/$defs/IdentityStrength"
    },
    "inputDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inputdigest",
      "type": "string"
    },
    "nativeBaselineDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Nativebaselinedigest",
      "type": "string"
    },
    "operationalDecision": {
      "$ref": "#/$defs/OperationalDecision"
    },
    "originalExperimentEconomics": {
      "$ref": "#/$defs/ExperimentEconomics"
    },
    "outcome": {
      "$ref": "#/$defs/EligibilityOutcome"
    },
    "policyVerifications": {
      "items": {
        "$ref": "#/$defs/MachineVerification"
      },
      "minItems": 1,
      "title": "Policyverifications",
      "type": "array"
    },
    "proposedExperimentEconomics": {
      "$ref": "#/$defs/ExperimentEconomics"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "schemaVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "technicalResult": {
      "$ref": "#/$defs/TechnicalResult"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "workloadId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Workloadid",
      "type": "string"
    }
  },
  "required": [
    "caseId",
    "inputDigest",
    "workloadId",
    "baselineEnvironmentId",
    "candidateEnvironmentId",
    "evidenceRefs",
    "nativeBaselineDigest",
    "policyVerifications",
    "originalExperimentEconomics",
    "proposedExperimentEconomics",
    "outcome",
    "identityStrength",
    "technicalResult",
    "operationalDecision",
    "reasons",
    "unknowns",
    "generatedAt"
  ],
  "title": "EligibilityDecision",
  "type": "object"
}
