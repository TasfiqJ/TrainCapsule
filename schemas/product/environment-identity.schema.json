{
  "$defs": {
    "DataIdentityPolicy": {
      "enum": [
        "FULL_DIGEST",
        "MANIFEST_DIGEST",
        "CUSTOMER_ATTESTED",
        "UNAVAILABLE"
      ],
      "title": "DataIdentityPolicy",
      "type": "string"
    },
    "GpuIdentity": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 0,
          "maximum": 131072,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "firmwareDigest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firmwaredigest"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "GpuIdentity",
      "type": "object"
    },
    "IdentityStrength": {
      "enum": [
        "FULLY_VERIFIED",
        "PARTIALLY_VERIFIED",
        "CUSTOMER_ATTESTED",
        "UNVERIFIED",
        "CONFLICTING"
      ],
      "title": "IdentityStrength",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "containerRuntime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Containerruntime"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "cudaDriver": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cudadriver"
    },
    "cudaRuntime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cudaruntime"
    },
    "environmentId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Environmentid",
      "type": "string"
    },
    "environmentVariablesDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Environmentvariablesdigest",
      "type": "string"
    },
    "gpu": {
      "$ref": "#/$defs/GpuIdentity"
    },
    "hostKernel": {
      "minLength": 1,
      "title": "Hostkernel",
      "type": "string"
    },
    "identityEvidenceDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identityevidencedigest"
    },
    "identityPolicy": {
      "$ref": "#/$defs/DataIdentityPolicy"
    },
    "identityStrength": {
      "$ref": "#/$defs/IdentityStrength"
    },
    "launcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Launcher"
    },
    "materializationRecipeDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Materializationrecipedigest"
    },
    "nccl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nccl"
    },
    "networkClass": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Networkclass"
    },
    "packagesDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Packagesdigest",
      "type": "string"
    },
    "python": {
      "minLength": 1,
      "title": "Python",
      "type": "string"
    },
    "pytorch": {
      "minLength": 1,
      "title": "Pytorch",
      "type": "string"
    },
    "redactionPolicyVersion": {
      "minLength": 1,
      "title": "Redactionpolicyversion",
      "type": "string"
    },
    "scheduler": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduler"
    },
    "schemaVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "storageClass": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storageclass"
    },
    "topologyDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topologydigest"
    }
  },
  "required": [
    "environmentId",
    "identityStrength",
    "identityPolicy",
    "hostKernel",
    "python",
    "packagesDigest",
    "pytorch",
    "gpu",
    "environmentVariablesDigest",
    "redactionPolicyVersion",
    "createdAt"
  ],
  "title": "EnvironmentIdentity",
  "type": "object"
}
