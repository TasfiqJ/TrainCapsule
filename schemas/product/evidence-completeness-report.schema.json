{
  "$defs": {
    "CompletenessState": {
      "enum": [
        "PRESENT_VALID",
        "PRESENT_PARTIAL",
        "PRESENT_CONFLICTING",
        "PRESENT_CORRUPTED",
        "MISSING_NOT_CAPTURED",
        "MISSING_POLICY_RESTRICTED",
        "MISSING_TECHNICALLY_INACCESSIBLE",
        "MISSING_VERSION_UNSUPPORTED",
        "IDENTITY_UNBOUND",
        "NOT_APPLICABLE"
      ],
      "title": "CompletenessState",
      "type": "string"
    },
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "artifactRefs": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Artifactrefs",
          "type": "array"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CompletenessState"
        }
      },
      "required": [
        "kind",
        "state",
        "artifactRefs",
        "detail"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "TechnicalResult": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "INVALID_EVIDENCE",
        "INVALID_ORACLE",
        "INFRASTRUCTURE_ERROR",
        "POLICY_BLOCKED",
        "EXPIRED"
      ],
      "title": "TechnicalResult",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caseId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Caseid",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/EvidenceRequirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "schemaVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "technicalResult": {
      "$ref": "#/$defs/TechnicalResult"
    }
  },
  "required": [
    "caseId",
    "requirements",
    "technicalResult"
  ],
  "title": "EvidenceCompletenessReport",
  "type": "object"
}
