{
  "$defs": {
    "RemoteCIConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true,
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "requiredWorkflows": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requiredworkflows",
          "type": "array"
        },
        "trustedCheckAppIds": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "title": "Trustedcheckappids",
          "type": "object"
        },
        "postMergeRequiredWorkflows": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Postmergerequiredworkflows",
          "type": "array"
        },
        "requiredRiskTiers": {
          "items": {
            "$ref": "#/$defs/RiskTier"
          },
          "title": "Requiredrisktiers",
          "type": "array"
        },
        "timeoutSeconds": {
          "default": 1800,
          "maximum": 14400,
          "minimum": 60,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "pollSeconds": {
          "default": 20,
          "maximum": 300,
          "minimum": 5,
          "title": "Pollseconds",
          "type": "integer"
        },
        "failClosed": {
          "const": true,
          "default": true,
          "title": "Failclosed",
          "type": "boolean"
        }
      },
      "required": [
        "trustedCheckAppIds",
        "postMergeRequiredWorkflows"
      ],
      "title": "RemoteCIConfig",
      "type": "object"
    },
    "RiskTier": {
      "enum": [
        "mechanical",
        "standard",
        "integration",
        "trust_core"
      ],
      "title": "RiskTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.1",
      "default": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "remote": {
      "const": "origin",
      "default": "origin",
      "title": "Remote",
      "type": "string"
    },
    "baseBranch": {
      "const": "main",
      "default": "main",
      "title": "Basebranch",
      "type": "string"
    },
    "visibility": {
      "const": "public",
      "default": "public",
      "title": "Visibility",
      "type": "string"
    },
    "repository": {
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "releaseMode": {
      "const": "DIRECT_MAIN_EXACT_SHA_MACHINE_RECEIPT_POST_PUSH_VERIFY",
      "default": "DIRECT_MAIN_EXACT_SHA_MACHINE_RECEIPT_POST_PUSH_VERIFY",
      "title": "Releasemode",
      "type": "string"
    },
    "directMainPush": {
      "const": true,
      "default": true,
      "title": "Directmainpush",
      "type": "boolean"
    },
    "transactionPath": {
      "const": "publication-transactions",
      "default": "publication-transactions",
      "title": "Transactionpath",
      "type": "string"
    },
    "quarantinePath": {
      "const": "publication-quarantine",
      "default": "publication-quarantine",
      "title": "Quarantinepath",
      "type": "string"
    },
    "independentReceiptRoot": {
      "minLength": 1,
      "title": "Independentreceiptroot",
      "type": "string"
    },
    "receiptVerifierExecutable": {
      "minLength": 1,
      "title": "Receiptverifierexecutable",
      "type": "string"
    },
    "activationReceiptPath": {
      "minLength": 1,
      "title": "Activationreceiptpath",
      "type": "string"
    },
    "exactHeadShaChecksRequired": {
      "const": true,
      "default": true,
      "title": "Exactheadshachecksrequired",
      "type": "boolean"
    },
    "independentMachinePolicyReceiptRequired": {
      "const": true,
      "default": true,
      "title": "Independentmachinepolicyreceiptrequired",
      "type": "boolean"
    },
    "mergeQueueOrAutoMergeRequired": {
      "const": false,
      "default": false,
      "title": "Mergequeueorautomergerequired",
      "type": "boolean"
    },
    "exactMergedMainVerificationRequired": {
      "const": true,
      "default": true,
      "title": "Exactmergedmainverificationrequired",
      "type": "boolean"
    },
    "publisherCapability": {
      "const": "DIRECT_MAIN_V31_READY",
      "default": "DIRECT_MAIN_V31_READY",
      "title": "Publishercapability",
      "type": "string"
    },
    "retryAttempts": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "title": "Retryattempts",
      "type": "integer"
    },
    "retryBackoffSeconds": {
      "default": 30,
      "maximum": 3600,
      "minimum": 1,
      "title": "Retrybackoffseconds",
      "type": "integer"
    },
    "verifyRemoteSha": {
      "const": true,
      "default": true,
      "title": "Verifyremotesha",
      "type": "boolean"
    },
    "commitSubjectMaxChars": {
      "default": 50,
      "maximum": 72,
      "minimum": 20,
      "title": "Commitsubjectmaxchars",
      "type": "integer"
    },
    "remoteCi": {
      "$ref": "#/$defs/RemoteCIConfig"
    }
  },
  "required": [
    "repository",
    "independentReceiptRoot",
    "receiptVerifierExecutable",
    "activationReceiptPath",
    "remoteCi"
  ],
  "title": "GitHubConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/github-config.schema.json"
}
