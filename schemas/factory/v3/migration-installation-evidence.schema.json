{
  "$defs": {
    "AuthorityTreeBinding": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "minLength": 1,
          "title": "Root",
          "type": "string"
        },
        "fileCount": {
          "minimum": 1,
          "title": "Filecount",
          "type": "integer"
        },
        "treeSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Treesha256",
          "type": "string"
        },
        "installationCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Installationcommit",
          "type": "string"
        },
        "treeAtInstallationSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Treeatinstallationsha256",
          "type": "string"
        }
      },
      "required": [
        "root",
        "fileCount",
        "treeSha256",
        "installationCommit",
        "treeAtInstallationSha256"
      ],
      "title": "AuthorityTreeBinding",
      "type": "object"
    },
    "CoverageBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "docs/source-of-truth/v3.1-zh-2026-08-12/SECTION_COVERAGE_V3_TO_V3_1_ZH.json",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sourceHeadingCount": {
          "const": 504,
          "title": "Sourceheadingcount",
          "type": "integer"
        },
        "mappedHeadingCount": {
          "const": 504,
          "title": "Mappedheadingcount",
          "type": "integer"
        },
        "complete": {
          "const": true,
          "title": "Complete",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "sha256",
        "sourceHeadingCount",
        "mappedHeadingCount",
        "complete"
      ],
      "title": "CoverageBinding",
      "type": "object"
    },
    "PreservedAuthorityProof": {
      "additionalProperties": false,
      "properties": {
        "comparisonCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Comparisoncommit",
          "type": "string"
        },
        "treeAtComparisonSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Treeatcomparisonsha256",
          "type": "string"
        },
        "currentTreeSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Currenttreesha256",
          "type": "string"
        },
        "noPostInstallMutation": {
          "const": true,
          "title": "Nopostinstallmutation",
          "type": "boolean"
        }
      },
      "required": [
        "comparisonCommit",
        "treeAtComparisonSha256",
        "currentTreeSha256",
        "noPostInstallMutation"
      ],
      "title": "PreservedAuthorityProof",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "workItemId": {
      "const": "V3-MIG-003",
      "default": "V3-MIG-003",
      "title": "Workitemid",
      "type": "string"
    },
    "evidenceType": {
      "const": "DETERMINISTIC_SOURCE_INSTALLATION",
      "default": "DETERMINISTIC_SOURCE_INSTALLATION",
      "title": "Evidencetype",
      "type": "string"
    },
    "migrationBaseCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Migrationbasecommit",
      "type": "string"
    },
    "oldAuthority": {
      "$ref": "#/$defs/AuthorityTreeBinding"
    },
    "newAuthority": {
      "$ref": "#/$defs/AuthorityTreeBinding"
    },
    "preservedOldAuthority": {
      "$ref": "#/$defs/PreservedAuthorityProof"
    },
    "oldManifestPath": {
      "const": "docs/source-of-truth/v3-2026-08-11/FINAL_MANIFEST_V3.json",
      "title": "Oldmanifestpath",
      "type": "string"
    },
    "oldManifestSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Oldmanifestsha256",
      "type": "string"
    },
    "newManifestPath": {
      "const": "docs/source-of-truth/v3.1-zh-2026-08-12/FINAL_MANIFEST_V3_1_ZH.json",
      "title": "Newmanifestpath",
      "type": "string"
    },
    "newManifestSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Newmanifestsha256",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageBinding"
    }
  },
  "required": [
    "migrationBaseCommit",
    "oldAuthority",
    "newAuthority",
    "preservedOldAuthority",
    "oldManifestPath",
    "oldManifestSha256",
    "newManifestPath",
    "newManifestSha256",
    "coverage"
  ],
  "title": "MigrationInstallationEvidence",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/migration-installation-evidence.schema.json"
}
