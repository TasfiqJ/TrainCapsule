{
  "$defs": {
    "ActivationMode": {
      "enum": [
        "OBSERVATION",
        "CANARY",
        "LIVE"
      ],
      "title": "ActivationMode",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "GitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^/].*$",
      "type": "string"
    },
    "SourceGenerationId": {
      "maxLength": 128,
      "minLength": 3,
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/verifier/v3.1/activation-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controllerBinaryDigest": {
      "$ref": "#/$defs/Digest"
    },
    "controllerBinaryPath": {
      "$ref": "#/$defs/RelativePath"
    },
    "controllerConfigDigest": {
      "$ref": "#/$defs/Digest"
    },
    "controllerConfigPath": {
      "$ref": "#/$defs/RelativePath"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "issuedAt": {
      "format": "date-time",
      "title": "Issuedat",
      "type": "string"
    },
    "issuerId": {
      "$ref": "#/$defs/Identifier"
    },
    "issuerKeyId": {
      "$ref": "#/$defs/Identifier"
    },
    "machineEnvironmentDigest": {
      "$ref": "#/$defs/Digest"
    },
    "machineEnvironmentPath": {
      "$ref": "#/$defs/RelativePath"
    },
    "machinePolicyReceiptDigest": {
      "$ref": "#/$defs/Digest"
    },
    "machinePolicyReceiptId": {
      "$ref": "#/$defs/Identifier"
    },
    "mode": {
      "$ref": "#/$defs/ActivationMode"
    },
    "nonce": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Nonce",
      "type": "string"
    },
    "receiptId": {
      "$ref": "#/$defs/Identifier"
    },
    "revocationEpoch": {
      "minimum": 1,
      "title": "Revocationepoch",
      "type": "integer"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "signature": {
      "maxLength": 128,
      "minLength": 80,
      "title": "Signature",
      "type": "string"
    },
    "signatureAlgorithm": {
      "const": "ed25519",
      "title": "Signaturealgorithm",
      "type": "string"
    },
    "sourceGenerationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "sourceGenerationId": {
      "$ref": "#/$defs/SourceGenerationId"
    },
    "verifiedMainSha": {
      "$ref": "#/$defs/GitSha"
    }
  },
  "required": [
    "schemaVersion",
    "receiptId",
    "verifiedMainSha",
    "machineEnvironmentDigest",
    "sourceGenerationId",
    "sourceGenerationDigest",
    "controllerBinaryDigest",
    "controllerConfigDigest",
    "machineEnvironmentPath",
    "controllerBinaryPath",
    "controllerConfigPath",
    "machinePolicyReceiptId",
    "machinePolicyReceiptDigest",
    "mode",
    "issuedAt",
    "expiresAt",
    "revocationEpoch",
    "nonce",
    "issuerId",
    "issuerKeyId",
    "signatureAlgorithm",
    "signature"
  ],
  "title": "ActivationReceipt",
  "type": "object"
}
