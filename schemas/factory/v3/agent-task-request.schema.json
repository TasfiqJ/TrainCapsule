{
  "$defs": {
    "BashCommandRule": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Executable",
          "type": "string"
        },
        "argumentPrefix": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Argumentprefix",
          "type": "array"
        }
      },
      "required": [
        "executable",
        "argumentPrefix"
      ],
      "title": "BashCommandRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "pattern": "^AREQ-[A-Z0-9_-]+$",
      "title": "Requestid",
      "type": "string"
    },
    "workItemId": {
      "title": "Workitemid",
      "type": "string"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "taskPacket": {
      "additionalProperties": true,
      "title": "Taskpacket",
      "type": "object"
    },
    "sourceContextManifest": {
      "additionalProperties": true,
      "title": "Sourcecontextmanifest",
      "type": "object"
    },
    "allowedPaths": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Allowedpaths",
      "type": "array"
    },
    "forbiddenPaths": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Forbiddenpaths",
      "type": "array"
    },
    "networkPolicy": {
      "pattern": "^(DENY|ALLOWLIST)$",
      "title": "Networkpolicy",
      "type": "string"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "Outputschema",
      "type": "object"
    },
    "controllerRepoRoot": {
      "title": "Controllerreporoot",
      "type": "string"
    },
    "candidateWorktree": {
      "title": "Candidateworktree",
      "type": "string"
    },
    "artifactRoot": {
      "title": "Artifactroot",
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "systemPrompt": {
      "minLength": 1,
      "title": "Systemprompt",
      "type": "string"
    },
    "schemaDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Schemadigest",
      "type": "string"
    },
    "contextDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contextdigest",
      "type": "string"
    },
    "sourceDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sourcedigest",
      "type": "string"
    },
    "maxTurns": {
      "maximum": 200,
      "minimum": 1,
      "title": "Maxturns",
      "type": "integer"
    },
    "maxTokens": {
      "maximum": 250000,
      "minimum": 1000,
      "title": "Maxtokens",
      "type": "integer"
    },
    "maxCostUsdEquivalent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Maxcostusdequivalent",
      "type": "number"
    },
    "maxWallTimeSeconds": {
      "maximum": 14400,
      "minimum": 1,
      "title": "Maxwalltimeseconds",
      "type": "integer"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "bashAllowlist": {
      "items": {
        "$ref": "#/$defs/BashCommandRule"
      },
      "maxItems": 16,
      "title": "Bashallowlist",
      "type": "array"
    },
    "networkAllowed": {
      "default": false,
      "title": "Networkallowed",
      "type": "boolean"
    }
  },
  "required": [
    "requestId",
    "workItemId",
    "role",
    "taskPacket",
    "sourceContextManifest",
    "allowedPaths",
    "networkPolicy",
    "outputSchema",
    "controllerRepoRoot",
    "candidateWorktree",
    "artifactRoot",
    "prompt",
    "systemPrompt",
    "schemaDigest",
    "contextDigest",
    "sourceDigest",
    "maxTurns",
    "maxTokens",
    "maxCostUsdEquivalent",
    "maxWallTimeSeconds",
    "tools",
    "bashAllowlist"
  ],
  "title": "AgentTaskRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/agent-task-request.schema.json"
}
