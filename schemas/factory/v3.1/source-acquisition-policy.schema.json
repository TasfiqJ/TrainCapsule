{
  "$id": "https://traincapsule.local/schemas/factory/v3.1/source-acquisition-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedContentTypes": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Allowedcontenttypes",
      "type": "array"
    },
    "allowedHostnames": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Allowedhostnames",
      "type": "array"
    },
    "allowedMethods": {
      "items": {
        "const": "GET",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Allowedmethods",
      "type": "array"
    },
    "maxRedirects": {
      "default": 3,
      "maximum": 5,
      "minimum": 0,
      "title": "Maxredirects",
      "type": "integer"
    },
    "maxResponseBytes": {
      "maximum": 16777216,
      "minimum": 1,
      "title": "Maxresponsebytes",
      "type": "integer"
    },
    "maxSourcesPerPlan": {
      "maximum": 64,
      "minimum": 1,
      "title": "Maxsourcesperplan",
      "type": "integer"
    },
    "maximumFreshnessSeconds": {
      "default": 86400,
      "maximum": 7776000,
      "minimum": 60,
      "title": "Maximumfreshnessseconds",
      "type": "integer"
    },
    "policyId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Policyid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "timeoutSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeoutseconds",
      "type": "number"
    },
    "userAgent": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Useragent",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "policyId",
    "allowedHostnames",
    "timeoutSeconds",
    "maxResponseBytes",
    "maxSourcesPerPlan",
    "allowedContentTypes",
    "userAgent"
  ],
  "title": "SourceAcquisitionPolicy",
  "type": "object"
}
