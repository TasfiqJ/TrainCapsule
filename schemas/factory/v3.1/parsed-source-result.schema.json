{
  "$defs": {
    "ParsedClaimResult": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
          "title": "Claimid",
          "type": "string"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ResearchVerdict"
        }
      },
      "required": [
        "schemaVersion",
        "claimId",
        "verdict",
        "statement"
      ],
      "title": "ParsedClaimResult",
      "type": "object"
    },
    "ResearchVerdict": {
      "enum": [
        "CLEAR",
        "CONFLICT",
        "UNKNOWN"
      ],
      "title": "ResearchVerdict",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/parsed-source-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimResults": {
      "items": {
        "$ref": "#/$defs/ParsedClaimResult"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Claimresults",
      "type": "array"
    },
    "contentType": {
      "title": "Contenttype",
      "type": "string"
    },
    "parserId": {
      "title": "Parserid",
      "type": "string"
    },
    "parserVersion": {
      "title": "Parserversion",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "parserId",
    "parserVersion",
    "contentType",
    "claimResults"
  ],
  "title": "ParsedSourceResult",
  "type": "object"
}
