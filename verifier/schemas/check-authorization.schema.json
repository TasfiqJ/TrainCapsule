{
  "$defs": {
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "GitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/verifier/v3.1/check-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateSha": {
      "$ref": "#/$defs/GitSha"
    },
    "checkName": {
      "const": "TrainCapsule / Machine policy",
      "title": "Checkname",
      "type": "string"
    },
    "conclusion": {
      "const": "success",
      "title": "Conclusion",
      "type": "string"
    },
    "receiptDigest": {
      "$ref": "#/$defs/Digest"
    },
    "receiptId": {
      "$ref": "#/$defs/Identifier"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "checkName",
    "candidateSha",
    "conclusion",
    "receiptId",
    "receiptDigest"
  ],
  "title": "CheckAuthorization",
  "type": "object"
}
