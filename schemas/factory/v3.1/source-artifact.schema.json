{
  "$defs": {
    "SourceClass": {
      "enum": [
        "OFFICIAL_REGISTRY",
        "OFFICIAL_DOCUMENTATION",
        "STANDARDS_BODY",
        "COMPANY_PRIMARY",
        "PUBLIC_REPOSITORY"
      ],
      "title": "SourceClass",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/source-artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactPath": {
      "pattern": "^[^/\\\\]+$",
      "title": "Artifactpath",
      "type": "string"
    },
    "claimIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Claimids",
      "type": "array"
    },
    "contentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contentdigest",
      "type": "string"
    },
    "contentLength": {
      "minimum": 0,
      "title": "Contentlength",
      "type": "integer"
    },
    "contentType": {
      "title": "Contenttype",
      "type": "string"
    },
    "finalUrl": {
      "title": "Finalurl",
      "type": "string"
    },
    "headersDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Headersdigest",
      "type": "string"
    },
    "observedAt": {
      "format": "date-time",
      "title": "Observedat",
      "type": "string"
    },
    "requestedUrl": {
      "title": "Requestedurl",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceClass": {
      "$ref": "#/$defs/SourceClass"
    },
    "sourceId": {
      "title": "Sourceid",
      "type": "string"
    },
    "statusCode": {
      "maximum": 599,
      "minimum": 100,
      "title": "Statuscode",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "sourceId",
    "sourceClass",
    "requestedUrl",
    "finalUrl",
    "observedAt",
    "statusCode",
    "contentType",
    "contentLength",
    "contentDigest",
    "headersDigest",
    "artifactPath",
    "claimIds"
  ],
  "title": "SourceArtifact",
  "type": "object"
}
