{
  "$defs": {
    "MandatoryCanaryId": {
      "enum": [
        "real_claude_mechanical_task",
        "process_kill_and_resume",
        "quota_pause_and_resume",
        "authentication_expiry_and_recovery",
        "repeated_finding_finite_stop",
        "external_wait_lane_isolation",
        "bad_candidate_rejected_before_main",
        "release_transaction_crash_idempotency",
        "automatic_milestone_advancement",
        "machine_receipt_missing_invalid_expired_revoked",
        "duplicate_controller_rejection",
        "lease_renewal_failure",
        "stale_current_facts",
        "missing_source_authority",
        "malformed_report",
        "private_gate_missing_for_trust_risk",
        "machine_verifier_unavailable",
        "activation_receipt_wrong_sha",
        "runtime_root_outside_repo",
        "post_push_invariant_failure_and_automatic_direct_revert"
      ],
      "title": "MandatoryCanaryId",
      "type": "string"
    },
    "MechanismPolicy": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "pattern": "^/usr/libexec/traincapsule-canary-[a-z0-9_-]+$",
          "title": "Executable",
          "type": "string"
        },
        "executableDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Executabledigest",
          "type": "string"
        },
        "networkAllowed": {
          "title": "Networkallowed",
          "type": "boolean"
        },
        "timeoutSeconds": {
          "maximum": 14400,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "executable",
        "executableDigest",
        "timeoutSeconds",
        "networkAllowed"
      ],
      "title": "MechanismPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "distributionDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Distributiondigest",
      "type": "string"
    },
    "mechanisms": {
      "additionalProperties": {
        "$ref": "#/$defs/MechanismPolicy"
      },
      "propertyNames": {
        "$ref": "#/$defs/MandatoryCanaryId"
      },
      "title": "Mechanisms",
      "type": "object"
    },
    "runnerExecutableDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runnerexecutabledigest",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runnerExecutableDigest",
    "distributionDigest",
    "mechanisms"
  ],
  "title": "RunnerPolicy",
  "type": "object"
}
