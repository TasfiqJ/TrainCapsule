{
  "$defs": {
    "CommercialState": {
      "enum": [
        "NOT_EVALUATED",
        "NATIVE_ADVANTAGE_UNPROVEN",
        "PILOT_ELIGIBLE",
        "COMMERCIALLY_SUPPORTED",
        "WITHDRAWN"
      ],
      "title": "CommercialState",
      "type": "string"
    },
    "DecisionValueDisposition": {
      "enum": [
        "NATIVE_WORKFLOW_SUFFICIENT",
        "NO_INCREMENTAL_DECISION_VALUE",
        "TECHNICALLY_VALID_BUT_NOT_ECONOMIC",
        "INCREMENTAL_DECISION_VALUE_DEMONSTRATED",
        "EXTERNAL_EVIDENCE_REQUIRED",
        "UNKNOWN"
      ],
      "title": "DecisionValueDisposition",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ExternalActionChannel": {
      "enum": [
        "EMAIL",
        "CRM",
        "CALENDAR"
      ],
      "title": "ExternalActionChannel",
      "type": "string"
    },
    "ExternalActionTemplate": {
      "additionalProperties": false,
      "properties": {
        "bodyTemplate": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Bodytemplate",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/ExternalActionChannel"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "subjectTemplate": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Subjecttemplate",
          "type": "string"
        },
        "templateId": {
          "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
          "title": "Templateid",
          "type": "string"
        },
        "variableNames": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Variablenames",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "templateId",
        "channel",
        "subjectTemplate",
        "bodyTemplate",
        "variableNames"
      ],
      "title": "ExternalActionTemplate",
      "type": "object"
    },
    "GateResult": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "GateResult",
      "type": "string"
    },
    "GitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "Lane": {
      "enum": [
        "PRODUCT",
        "MARKET",
        "COMPETITOR",
        "TRUST",
        "FACTORY"
      ],
      "title": "Lane",
      "type": "string"
    },
    "MachinePolicyReceiptV31": {
      "additionalProperties": false,
      "properties": {
        "allowedClaims": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Allowedclaims",
          "type": "array"
        },
        "baseSha": {
          "$ref": "#/$defs/GitSha"
        },
        "candidateManifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "candidateSha": {
          "$ref": "#/$defs/GitSha"
        },
        "candidateTreeSha": {
          "$ref": "#/$defs/GitSha"
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "commercialMaturityCeiling": {
          "$ref": "#/$defs/CommercialState"
        },
        "contextManifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "decisionValueDisposition": {
          "$ref": "#/$defs/DecisionValueDisposition"
        },
        "engineeringMaturityCeiling": {
          "$ref": "#/$defs/TechnicalState"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "forbiddenClaims": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 64,
          "title": "Forbiddenclaims",
          "type": "array"
        },
        "independentOracleIds": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Independentoracleids",
          "type": "array"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "issuerId": {
          "$ref": "#/$defs/Identifier"
        },
        "issuerKeyId": {
          "$ref": "#/$defs/Identifier"
        },
        "lane": {
          "$ref": "#/$defs/Lane"
        },
        "milestoneId": {
          "pattern": "^M[0-9]+_[A-Z0-9_]+$",
          "title": "Milestoneid",
          "type": "string"
        },
        "nativeSubstituteDisposition": {
          "$ref": "#/$defs/NativeSubstituteDisposition"
        },
        "nonce": {
          "maxLength": 256,
          "minLength": 16,
          "title": "Nonce",
          "type": "string"
        },
        "policyId": {
          "$ref": "#/$defs/Identifier"
        },
        "policyVersion": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policyversion",
          "type": "string"
        },
        "privateGateRunnerDigest": {
          "$ref": "#/$defs/Digest"
        },
        "privateGateSuiteId": {
          "$ref": "#/$defs/Identifier"
        },
        "publicationScope": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Publicationscope",
          "type": "array"
        },
        "rawEvidenceArtifactHashes": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Rawevidenceartifacthashes",
          "type": "array"
        },
        "receiptId": {
          "$ref": "#/$defs/Identifier"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "requiredGateResults": {
          "additionalProperties": {
            "$ref": "#/$defs/GateResult"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Requiredgateresults",
          "type": "object"
        },
        "revocationEpoch": {
          "minimum": 1,
          "title": "Revocationepoch",
          "type": "integer"
        },
        "riskTier": {
          "$ref": "#/$defs/RiskTier"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "signature": {
          "maxLength": 1024,
          "minLength": 32,
          "title": "Signature",
          "type": "string"
        },
        "signatureAlgorithm": {
          "const": "ed25519",
          "title": "Signaturealgorithm",
          "type": "string"
        },
        "sourceGenerationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "sourceGenerationId": {
          "$ref": "#/$defs/SourceGenerationId"
        },
        "taskPacketDigest": {
          "$ref": "#/$defs/Digest"
        },
        "workItemId": {
          "pattern": "^V3-[A-Z]+-[0-9]{3}$",
          "title": "Workitemid",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "receiptId",
        "policyId",
        "policyVersion",
        "issuerId",
        "issuerKeyId",
        "issuedAt",
        "expiresAt",
        "revocationEpoch",
        "nonce",
        "requestDigest",
        "workItemId",
        "milestoneId",
        "lane",
        "riskTier",
        "candidateSha",
        "candidateTreeSha",
        "baseSha",
        "sourceGenerationId",
        "sourceGenerationDigest",
        "contextManifestDigest",
        "taskPacketDigest",
        "candidateManifestDigest",
        "checkpointDigest",
        "requiredGateResults",
        "privateGateSuiteId",
        "privateGateRunnerDigest",
        "independentOracleIds",
        "rawEvidenceArtifactHashes",
        "nativeSubstituteDisposition",
        "decisionValueDisposition",
        "engineeringMaturityCeiling",
        "commercialMaturityCeiling",
        "allowedClaims",
        "publicationScope",
        "decision",
        "signatureAlgorithm",
        "signature"
      ],
      "title": "MachinePolicyReceiptV31",
      "type": "object"
    },
    "NativeSubstituteDisposition": {
      "enum": [
        "NATIVE_SUFFICIENT",
        "INCREMENTAL_VALUE",
        "NOT_COMPARABLE",
        "UNKNOWN"
      ],
      "title": "NativeSubstituteDisposition",
      "type": "string"
    },
    "PolicyDecision": {
      "enum": [
        "PASS",
        "DENY",
        "UNKNOWN"
      ],
      "title": "PolicyDecision",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^/].*$",
      "type": "string"
    },
    "RiskTier": {
      "enum": [
        "MECHANICAL",
        "STANDARD",
        "INTEGRATION",
        "TRUST_CORE",
        "EXTERNAL"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "SourceGenerationId": {
      "maxLength": 128,
      "minLength": 3,
      "type": "string"
    },
    "TechnicalState": {
      "enum": [
        "NOT_EVALUATED",
        "FAILED",
        "PASSED"
      ],
      "title": "TechnicalState",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/external-action-installation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "All controller-owned prerequisites required to enable one exact action shape.",
  "properties": {
    "backendId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Backendid",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/ExternalActionChannel"
    },
    "credentialReference": {
      "pattern": "^CREDREF:[A-Z0-9][A-Z0-9._/-]{2,127}$",
      "title": "Credentialreference",
      "type": "string"
    },
    "independentVerifierReceiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Independentverifierreceiptdigest",
      "type": "string"
    },
    "legalPolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Legalpolicydigest",
      "type": "string"
    },
    "legalPolicyId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Legalpolicyid",
      "type": "string"
    },
    "machinePolicyReceipt": {
      "$ref": "#/$defs/MachinePolicyReceiptV31"
    },
    "machinePolicyScope": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Machinepolicyscope",
      "type": "array"
    },
    "recipientAllowlist": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Recipientallowlist",
      "type": "array"
    },
    "safetyPolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Safetypolicydigest",
      "type": "string"
    },
    "safetyPolicyId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Safetypolicyid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/ExternalActionTemplate"
    }
  },
  "required": [
    "schemaVersion",
    "machinePolicyReceipt",
    "independentVerifierReceiptDigest",
    "credentialReference",
    "backendId",
    "recipientAllowlist",
    "legalPolicyId",
    "legalPolicyDigest",
    "safetyPolicyId",
    "safetyPolicyDigest",
    "machinePolicyScope",
    "channel",
    "template"
  ],
  "title": "ExternalActionInstallation",
  "type": "object"
}
