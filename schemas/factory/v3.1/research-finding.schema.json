{
  "$defs": {
    "ResearchVerdict": {
      "enum": [
        "CLEAR",
        "CONFLICT",
        "UNKNOWN"
      ],
      "title": "ResearchVerdict",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/research-finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimId": {
      "title": "Claimid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceArtifactDigests": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Sourceartifactdigests",
      "type": "array"
    },
    "statement": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/ResearchVerdict"
    }
  },
  "required": [
    "schemaVersion",
    "claimId",
    "verdict",
    "statement"
  ],
  "title": "ResearchFinding",
  "type": "object"
}
