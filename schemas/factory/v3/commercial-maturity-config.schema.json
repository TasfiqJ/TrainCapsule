      "title": "CommercialMaturity",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "CUSTOMER_CONVERSATION",
        "INCIDENT_ARCHIVE_ACCESS",
        "PAID_PREFLIGHT",
        "PAID_PILOT",
        "DECISION_CHANGED",
        "SECOND_PAID_ACTION",
        "INDEPENDENT_OPERATOR",
        "UPSTREAM_ACCEPTANCE",
        "PROVIDER_ACCEPTANCE"
      ],
      "title": "EvidenceType",
      "type": "string"
    }
