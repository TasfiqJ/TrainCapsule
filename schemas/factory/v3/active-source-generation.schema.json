      "type": "string"
    },
    "configPath": {
      "title": "Configpath",
      "type": "string"
    },
    "configDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configdigest",
      "type": "string"
    },
    "sourceRoot": {
      "title": "Sourceroot",
      "type": "string"
    },
    "manifestPath": {
      "title": "Manifestpath",
      "type": "string"
    },
    "manifestDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifestdigest",
      "type": "string"
    },
    "sourceDigest": {
