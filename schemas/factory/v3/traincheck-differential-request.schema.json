    },
    "incidentContractDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Incidentcontractdigest",
      "type": "string"
    },
    "baselineObservationDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baselineobservationdigest",
      "type": "string"
    },
    "candidateObservationDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidateobservationdigest",
      "type": "string"
    },
    "independentOracleId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
