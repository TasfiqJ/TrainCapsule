{
  "$defs": {
    "CanaryStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_PREREQUISITE"
      ],
      "title": "CanaryStatus",
      "type": "string"
    },
    "MandatoryCanaryId": {
      "enum": [
        "real_claude_mechanical_task",
        "process_kill_and_resume",
        "quota_pause_and_resume",
        "authentication_expiry_and_recovery",
        "repeated_finding_finite_stop",
        "external_wait_lane_isolation",
        "bad_candidate_rejected_before_main",
        "release_transaction_crash_idempotency",
        "automatic_milestone_advancement",
        "machine_receipt_missing_invalid_expired_revoked",
        "duplicate_controller_rejection",
        "lease_renewal_failure",
        "stale_current_facts",
        "missing_source_authority",
        "malformed_report",
        "private_gate_missing_for_trust_risk",
        "machine_verifier_unavailable",
        "activation_receipt_wrong_sha",
        "runtime_root_outside_repo",
        "post_push_invariant_failure_and_automatic_direct_revert"
      ],
      "title": "MandatoryCanaryId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canaryId": {
      "$ref": "#/$defs/MandatoryCanaryId"
    },
    "evidenceArtifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 128,
      "title": "Evidenceartifacts",
      "type": "object"
    },
    "exactMainSha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Exactmainsha",
      "type": "string"
    },
    "exactTreeSha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Exacttreesha",
      "type": "string"
    },
    "failureReason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failurereason"
    },
    "observedAt": {
      "format": "date-time",
      "title": "Observedat",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CanaryStatus"
    }
  },
  "required": [
    "schemaVersion",
    "canaryId",
    "runId",
    "exactMainSha",
    "exactTreeSha",
    "status",
    "observedAt"
  ],
  "title": "MechanismOutcome",
  "type": "object"
}
