{
  "$defs": {
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifactid",
          "type": "string"
        },
        "capturedAt": {
          "format": "date-time",
          "title": "Capturedat",
          "type": "string"
        },
        "caseId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Caseid",
          "type": "string"
        },
        "compression": {
          "default": "none",
          "title": "Compression",
          "type": "string"
        },
        "contentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contentdigest",
          "type": "string"
        },
        "customerLocalUri": {
          "pattern": "^cas://[A-Za-z0-9._/-]+$",
          "title": "Customerlocaluri",
          "type": "string"
        },
        "encryption": {
          "default": "none",
          "title": "Encryption",
          "type": "string"
        },
        "exportPolicy": {
          "minLength": 1,
          "title": "Exportpolicy",
          "type": "string"
        },
        "integrityStatus": {
          "$ref": "#/$defs/EvidenceIntegrity"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "privacyClass": {
          "$ref": "#/$defs/PrivacyClass"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        },
        "schemaVersion": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sourceAdapter": {
          "minLength": 1,
          "title": "Sourceadapter",
          "type": "string"
        },
        "sourceVersion": {
          "minLength": 1,
          "title": "Sourceversion",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "caseId",
        "kind",
        "sourceAdapter",
        "sourceVersion",
        "capturedAt",
        "contentDigest",
        "sizeBytes",
        "privacyClass",
        "customerLocalUri",
        "exportPolicy",
        "provenance",
        "integrityStatus"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceIntegrity": {
      "enum": [
        "VALID",
        "CORRUPTED",
        "UNKNOWN"
      ],
      "title": "EvidenceIntegrity",
      "type": "string"
    },
    "FindingAttribution": {
      "enum": [
        "NATIVE_TOOL_FOUND",
        "TRAINCAPSULE_DERIVED",
        "HUMAN_PROVIDED",
        "EXTERNAL_SYSTEM_PROVIDED",
        "UNKNOWN"
      ],
      "title": "FindingAttribution",
      "type": "string"
    },
    "NativeConfidence": {
      "enum": [
        "DIRECT_OBSERVATION",
        "DERIVED_ALIGNMENT",
        "TOOL_HEURISTIC",
        "UNVERIFIED_NARRATIVE"
      ],
      "title": "NativeConfidence",
      "type": "string"
    },
    "NativeFinding": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/FindingAttribution"
        },
        "confidenceClass": {
          "$ref": "#/$defs/NativeConfidence"
        },
        "customerDecisionContribution": {
          "minLength": 1,
          "title": "Customerdecisioncontribution",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidencerefs",
          "type": "array"
        },
        "findingId": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Findingid",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "nativeSystem": {
          "minLength": 1,
          "title": "Nativesystem",
          "type": "string"
        },
        "nativeVersion": {
          "minLength": 1,
          "title": "Nativeversion",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "schemaVersion": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "findingId",
        "attribution",
        "nativeSystem",
        "nativeVersion",
        "observation",
        "evidenceRefs",
        "confidenceClass",
        "limitations",
        "customerDecisionContribution"
      ],
      "title": "NativeFinding",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "PrivacyClass",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "caseId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Caseid",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "decisionEvidenceRefs": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Decisionevidencerefs",
      "type": "array"
    },
    "decisionPolicyVersion": {
      "const": "traincapsule-native-sufficiency-v1",
      "default": "traincapsule-native-sufficiency-v1",
      "title": "Decisionpolicyversion",
      "type": "string"
    },
    "decisionProvenanceDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decisionprovenancedigest"
    },
    "decisionReached": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decisionreached"
    },
    "elapsedSeconds": {
      "minimum": 0,
      "title": "Elapsedseconds",
      "type": "integer"
    },
    "executedAt": {
      "format": "date-time",
      "title": "Executedat",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/NativeFinding"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "generationPolicyVersion": {
      "const": "traincapsule-native-baseline-v1",
      "default": "traincapsule-native-baseline-v1",
      "title": "Generationpolicyversion",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "operatorEffortSeconds": {
      "minimum": 0,
      "title": "Operatoreffortseconds",
      "type": "integer"
    },
    "schemaVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "toolName": {
      "minLength": 1,
      "title": "Toolname",
      "type": "string"
    },
    "toolVersion": {
      "minLength": 1,
      "title": "Toolversion",
      "type": "string"
    },
    "unresolvedQuestions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolvedquestions",
      "type": "array"
    }
  },
  "required": [
    "caseId",
    "toolName",
    "toolVersion",
    "command",
    "configuration",
    "artifacts",
    "findings",
    "limitations",
    "elapsedSeconds",
    "operatorEffortSeconds",
    "decisionEvidenceRefs",
    "unresolvedQuestions",
    "executedAt"
  ],
  "title": "NativeBaseline",
  "type": "object"
}
