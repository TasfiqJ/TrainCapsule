{
  "$defs": {
    "CheckName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "GitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "SourceGenerationId": {
      "maxLength": 128,
      "minLength": 3,
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/verifier/v3.1/observed-main-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "githubAppId": {
      "exclusiveMinimum": 0,
      "title": "Githubappid",
      "type": "integer"
    },
    "issuerId": {
      "$ref": "#/$defs/Identifier"
    },
    "issuerKeyId": {
      "$ref": "#/$defs/Identifier"
    },
    "observationId": {
      "$ref": "#/$defs/Identifier"
    },
    "observedAt": {
      "format": "date-time",
      "title": "Observedat",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "requiredCheckDigests": {
      "additionalProperties": {
        "$ref": "#/$defs/Digest"
      },
      "maxProperties": 64,
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/CheckName"
      },
      "title": "Requiredcheckdigests",
      "type": "object"
    },
    "rulesetObservationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "signature": {
      "maxLength": 128,
      "minLength": 80,
      "title": "Signature",
      "type": "string"
    },
    "signatureAlgorithm": {
      "const": "ed25519",
      "title": "Signaturealgorithm",
      "type": "string"
    },
    "sourceGenerationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "sourceGenerationId": {
      "$ref": "#/$defs/SourceGenerationId"
    },
    "verifiedMainSha": {
      "$ref": "#/$defs/GitSha"
    },
    "verifiedMainTreeSha": {
      "$ref": "#/$defs/GitSha"
    }
  },
  "required": [
    "schemaVersion",
    "observationId",
    "repository",
    "verifiedMainSha",
    "verifiedMainTreeSha",
    "sourceGenerationId",
    "sourceGenerationDigest",
    "rulesetObservationDigest",
    "requiredCheckDigests",
    "githubAppId",
    "observedAt",
    "expiresAt",
    "issuerId",
    "issuerKeyId",
    "signatureAlgorithm",
    "signature"
  ],
  "title": "ObservedMainReceipt",
  "type": "object"
}
