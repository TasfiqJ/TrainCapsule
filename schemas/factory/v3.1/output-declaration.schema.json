{
  "$defs": {
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "OutputKind": {
      "enum": [
        "FILE",
        "DIRECTORY_MANIFEST",
        "REPORT",
        "RECEIPT",
        "SCHEMA"
      ],
      "title": "OutputKind",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^/].*$",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/output-declaration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/OutputKind"
    },
    "maximumBytes": {
      "maximum": 10000000000,
      "minimum": 1,
      "title": "Maximumbytes",
      "type": "integer"
    },
    "mediaType": {
      "maxLength": 127,
      "minLength": 3,
      "title": "Mediatype",
      "type": "string"
    },
    "outputId": {
      "$ref": "#/$defs/Identifier"
    },
    "path": {
      "$ref": "#/$defs/RelativePath"
    },
    "producerWorkItemId": {
      "pattern": "^V3-[A-Z]+-[0-9]{3}$",
      "title": "Producerworkitemid",
      "type": "string"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "retentionDays": {
      "maximum": 3650,
      "minimum": 1,
      "title": "Retentiondays",
      "type": "integer"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "outputId",
    "path",
    "kind",
    "mediaType",
    "required",
    "maximumBytes",
    "producerWorkItemId",
    "retentionDays"
  ],
  "title": "OutputDeclarationV31",
  "type": "object"
}
