{
  "$defs": {
    "LegacyDisposition": {
      "enum": [
        "FACTORY",
        "MAPPED_TO_V3",
        "DEFERRED_DESIGN",
        "DEFERRED_NON_BLOCKING"
      ],
      "title": "LegacyDisposition",
      "type": "string"
    },
    "LegacyMapRecord": {
      "additionalProperties": false,
      "properties": {
        "legacyTaskId": {
          "pattern": "^T[0-9]{3}$",
          "title": "Legacytaskid",
          "type": "string"
        },
        "legacyStatus": {
          "$ref": "#/$defs/LegacyStatus"
        },
        "legacyOutcome": {
          "minLength": 1,
          "title": "Legacyoutcome",
          "type": "string"
        },
        "legacyPacket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacypacket"
        },
        "v3Disposition": {
          "$ref": "#/$defs/LegacyDisposition"
        },
        "mappedWorkItems": {
          "items": {
            "pattern": "^V3-[A-Z]+-[0-9]{3}$",
            "type": "string"
          },
          "title": "Mappedworkitems",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidencePreserved": {
          "items": {
            "type": "string"
          },
          "title": "Evidencepreserved",
          "type": "array"
        }
      },
      "required": [
        "legacyTaskId",
        "legacyStatus",
        "legacyOutcome",
        "v3Disposition",
        "mappedWorkItems",
        "reason",
        "evidencePreserved"
      ],
      "title": "LegacyMapRecord",
      "type": "object"
    },
    "LegacyStatus": {
      "enum": [
        "blocked",
        "ready",
        "packet_proposed",
        "packet_approved",
        "queued",
        "running",
        "paused",
        "external_wait",
        "passed",
        "failed",
        "respec_required",
        "deferred"
      ],
      "title": "LegacyStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": 3,
      "maximum": 3,
      "minimum": 3,
      "title": "Version",
      "type": "integer"
    },
    "sourceVersion": {
      "default": 2,
      "maximum": 2,
      "minimum": 2,
      "title": "Sourceversion",
      "type": "integer"
    },
    "migrationBaseSha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Migrationbasesha",
      "type": "string"
    },
    "sourceLedgerDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sourceledgerdigest",
      "type": "string"
    },
    "sourcePolicyRef": {
      "minLength": 1,
      "title": "Sourcepolicyref",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/LegacyMapRecord"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "migrationBaseSha",
    "sourceLedgerDigest",
    "sourcePolicyRef",
    "records"
  ],
  "title": "LegacyMigrationMap",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/legacy-migration.schema.json"
}
