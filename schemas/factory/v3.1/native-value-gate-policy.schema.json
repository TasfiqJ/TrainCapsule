{
  "$defs": {
    "ApprovedAgentAssistanceV31": {
      "additionalProperties": false,
      "properties": {
        "allowedTasks": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowedtasks",
          "type": "array"
        },
        "configurationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "systemId": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "systemId",
        "version",
        "configurationDigest",
        "allowedTasks"
      ],
      "title": "ApprovedAgentAssistanceV31",
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "NativeToolConfigurationV31": {
      "additionalProperties": false,
      "properties": {
        "configurationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "schemaVersion": {
          "const": "3.1",
          "title": "Schemaversion",
          "type": "string"
        },
        "toolName": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Toolname",
          "type": "string"
        },
        "toolVersion": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Toolversion",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "toolName",
        "toolVersion",
        "configurationDigest"
      ],
      "title": "NativeToolConfigurationV31",
      "type": "object"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/native-value-gate-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvedAgentAssistance": {
      "items": {
        "$ref": "#/$defs/ApprovedAgentAssistanceV31"
      },
      "maxItems": 16,
      "title": "Approvedagentassistance",
      "type": "array"
    },
    "approvedNativeSubstitute": {
      "items": {
        "$ref": "#/$defs/NativeToolConfigurationV31"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Approvednativesubstitute",
      "type": "array"
    },
    "maximumTraincapsuleCostRatio": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Maximumtraincapsulecostratio",
      "type": "number"
    },
    "maximumTraincapsuleTimeRatio": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Maximumtraincapsuletimeratio",
      "type": "number"
    },
    "minimumRepetitions": {
      "maximum": 1000,
      "minimum": 2,
      "title": "Minimumrepetitions",
      "type": "integer"
    },
    "policyId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Policyid",
      "type": "string"
    },
    "requiredAllowedClaims": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Requiredallowedclaims",
      "type": "array"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "policyId",
    "approvedNativeSubstitute",
    "approvedAgentAssistance",
    "minimumRepetitions",
    "maximumTraincapsuleCostRatio",
    "maximumTraincapsuleTimeRatio",
    "requiredAllowedClaims"
  ],
  "title": "NativeValueGatePolicyV31",
  "type": "object"
}
