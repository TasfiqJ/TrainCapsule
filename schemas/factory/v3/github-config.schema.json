{
  "$defs": {
    "RemoteCIConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "requiredWorkflows": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requiredworkflows",
          "type": "array"
        },
        "requiredRiskTiers": {
          "items": {
            "$ref": "#/$defs/RiskTier"
          },
          "title": "Requiredrisktiers",
          "type": "array"
        },
        "timeoutSeconds": {
          "default": 1800,
          "maximum": 14400,
          "minimum": 60,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "pollSeconds": {
          "default": 20,
          "maximum": 300,
          "minimum": 5,
          "title": "Pollseconds",
          "type": "integer"
        },
        "failClosed": {
          "const": true,
          "default": true,
          "title": "Failclosed",
          "type": "boolean"
        }
      },
      "title": "RemoteCIConfig",
      "type": "object"
    },
    "RiskTier": {
      "enum": [
        "mechanical",
        "standard",
        "integration",
        "trust_core"
      ],
      "title": "RiskTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.1",
      "default": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "remote": {
      "const": "origin",
      "default": "origin",
      "title": "Remote",
      "type": "string"
    },
    "baseBranch": {
      "const": "main",
      "default": "main",
      "title": "Basebranch",
      "type": "string"
    },
    "visibility": {
      "const": "public",
      "default": "public",
      "title": "Visibility",
      "type": "string"
    },
    "repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "releaseMode": {
      "const": "AUTOMATED_PR_REQUIRED_CHECKS_MACHINE_RECEIPT_AUTO_MERGE",
      "default": "AUTOMATED_PR_REQUIRED_CHECKS_MACHINE_RECEIPT_AUTO_MERGE",
      "title": "Releasemode",
      "type": "string"
    },
    "directMainPush": {
      "const": false,
      "default": false,
      "title": "Directmainpush",
      "type": "boolean"
    },
    "candidateBranchPrefix": {
      "const": "factory/",
      "default": "factory/",
      "title": "Candidatebranchprefix",
      "type": "string"
    },
    "pullRequestMetadataPath": {
      "const": "factory/state/latest-pull-request.json",
      "default": "factory/state/latest-pull-request.json",
      "title": "Pullrequestmetadatapath",
      "type": "string"
    },
    "exactHeadShaChecksRequired": {
      "const": true,
      "default": true,
      "title": "Exactheadshachecksrequired",
      "type": "boolean"
    },
    "independentMachinePolicyReceiptRequired": {
      "const": true,
      "default": true,
      "title": "Independentmachinepolicyreceiptrequired",
      "type": "boolean"
    },
    "mergeQueueOrAutoMergeRequired": {
      "const": true,
      "default": true,
      "title": "Mergequeueorautomergerequired",
      "type": "boolean"
    },
    "exactMergedMainVerificationRequired": {
      "const": true,
      "default": true,
      "title": "Exactmergedmainverificationrequired",
      "type": "boolean"
    },
    "publisherCapability": {
      "const": "PENDING_PHASE_4",
      "default": "PENDING_PHASE_4",
      "title": "Publishercapability",
      "type": "string"
    },
    "retryAttempts": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "title": "Retryattempts",
      "type": "integer"
    },
    "retryBackoffSeconds": {
      "default": 30,
      "maximum": 3600,
      "minimum": 1,
      "title": "Retrybackoffseconds",
      "type": "integer"
    },
    "verifyRemoteSha": {
      "const": true,
      "default": true,
      "title": "Verifyremotesha",
      "type": "boolean"
    },
    "commitSubjectMaxChars": {
      "default": 50,
      "maximum": 72,
      "minimum": 20,
      "title": "Commitsubjectmaxchars",
      "type": "integer"
    },
    "remoteCi": {
      "$ref": "#/$defs/RemoteCIConfig"
    }
  },
  "title": "GitHubConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/github-config.schema.json"
}
