{
  "$defs": {
    "AuthorityDigests": {
      "additionalProperties": false,
      "description": "Exact active authority bytes under which an observation was accepted.",
      "properties": {
        "sourceManifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcemanifestsha256",
          "type": "string"
        },
        "activeGenerationSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activegenerationsha256",
          "type": "string"
        },
        "sourceGenerationSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcegenerationsha256",
          "type": "string"
        }
      },
      "required": [
        "sourceManifestSha256",
        "activeGenerationSha256",
        "sourceGenerationSha256"
      ],
      "title": "AuthorityDigests",
      "type": "object"
    },
    "DirectMainAcceptanceReceipt": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "const": "INDEPENDENT_MACHINE_VERIFIER",
          "title": "Issuer",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "nonce": {
          "minLength": 16,
          "title": "Nonce",
          "type": "string"
        },
        "revocationEpoch": {
          "minimum": 0,
          "title": "Revocationepoch",
          "type": "integer"
        },
        "signature": {
          "$ref": "#/$defs/IndependentReceiptSignature"
        },
        "receiptType": {
          "const": "V3_1_DIRECT_MAIN_PUBLICATION",
          "title": "Receipttype",
          "type": "string"
        },
        "taskClass": {
          "enum": [
            "MECHANICAL",
            "STANDARD"
          ],
          "title": "Taskclass",
          "type": "string"
        },
        "candidateSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Candidatesha",
          "type": "string"
        },
        "baseSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Basesha",
          "type": "string"
        },
        "observedMainSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Observedmainsha",
          "type": "string"
        },
        "fastForward": {
          "const": true,
          "title": "Fastforward",
          "type": "boolean"
        },
        "activeGenerationDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activegenerationdigest",
          "type": "string"
        },
        "sourceManifestDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcemanifestdigest",
          "type": "string"
        },
        "requiredChecks": {
          "items": {
            "$ref": "#/$defs/RequiredCheckReceipt"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Requiredchecks",
          "type": "array"
        }
      },
      "required": [
        "issuer",
        "issuedAt",
        "expiresAt",
        "nonce",
        "revocationEpoch",
        "signature",
        "receiptType",
        "taskClass",
        "candidateSha",
        "baseSha",
        "observedMainSha",
        "fastForward",
        "activeGenerationDigest",
        "sourceManifestDigest",
        "requiredChecks"
      ],
      "title": "DirectMainAcceptanceReceipt",
      "type": "object"
    },
    "EvidenceBinding": {
      "additionalProperties": false,
      "description": "Bind evidence without recursively hashing the evidence files themselves.",
      "properties": {
        "subjectSha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subjectsha"
        },
        "implementationTreeSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementationtreesha256"
        },
        "implementationTreeFileCount": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementationtreefilecount"
        },
        "algorithm": {
          "enum": [
            "git-commit-sha1",
            "sha256-mode-path-blob-manifest"
          ],
          "title": "Algorithm",
          "type": "string"
        }
      },
      "required": [
        "algorithm"
      ],
      "title": "EvidenceBinding",
      "type": "object"
    },
    "EvidenceExecution": {
      "additionalProperties": false,
      "description": "One replayable command and its immutable output transcript.",
      "properties": {
        "commandId": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "title": "Commandid",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Command",
          "type": "array"
        },
        "workingDirectory": {
          "const": ".",
          "default": ".",
          "title": "Workingdirectory",
          "type": "string"
        },
        "exitCode": {
          "maximum": 255,
          "minimum": 0,
          "title": "Exitcode",
          "type": "integer"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Result",
          "type": "string"
        },
        "passedCount": {
          "minimum": 0,
          "title": "Passedcount",
          "type": "integer"
        },
        "failedCount": {
          "minimum": 0,
          "title": "Failedcount",
          "type": "integer"
        },
        "failureAttribution": {
          "enum": [
            "NONE",
            "PRE_EXISTING",
            "INTRODUCED",
            "INFRASTRUCTURE",
            "UNKNOWN"
          ],
          "title": "Failureattribution",
          "type": "string"
        },
        "transcriptPath": {
          "minLength": 1,
          "title": "Transcriptpath",
          "type": "string"
        },
        "transcriptSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transcriptsha256",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "command",
        "exitCode",
        "result",
        "passedCount",
        "failedCount",
        "failureAttribution",
        "transcriptPath",
        "transcriptSha256"
      ],
      "title": "EvidenceExecution",
      "type": "object"
    },
    "FinalMigrationEvidence": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "workItemId": {
                "const": "V3-MIG-016"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceType": {
                "const": "SIGNED_SOURCE_MIGRATION_MACHINE_AUTHORIZATION"
              },
              "executions": {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "properties": {
                      "commandId": {
                        "const": "source-authority-integrity"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/python",
                          "scripts/gates/source_of_truth_integrity.py"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "commandId": {
                        "const": "active-policy-integrity"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/python",
                          "scripts/gates/active_policy_integrity.py"
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "commandId": {
                        "const": "authoritative-bundle-integrity"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/python",
                          "scripts/gates/v3_bundle_integrity.py",
                          "--check-report"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workItemId": {
                "const": "V3-MIG-017"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceType": {
                "const": "READ_ONLY_ROLLBACK_REHEARSAL"
              },
              "executions": {
                "maxItems": 1,
                "minItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "commandId": {
                        "const": "rollback-archive-rehearsal"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/python",
                          "scripts/gates/v3_rollback_rehearsal.py"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workItemId": {
                "const": "V3-MIG-018"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceType": {
                "const": "NON_MUTATING_CONTROLLER_OBSERVATION"
              },
              "executions": {
                "maxItems": 1,
                "minItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "commandId": {
                        "const": "controller-observation-contracts"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/pytest",
                          "tests/test_v3_config_and_roadmap.py",
                          "tests/test_v3_scheduler_and_recovery.py",
                          "tests/test_v3_supervisor_and_status.py"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workItemId": {
                "const": "V3-MIG-019"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceType": {
                "const": "DIRECT_MAIN_POST_PUSH_CI_ACCEPTANCE"
              },
              "executions": {
                "maxItems": 1,
                "minItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "commandId": {
                        "const": "controller-simulation"
                      },
                      "command": {
                        "const": [
                          ".venv/bin/pytest",
                          "tests/test_v3_controller_simulation.py"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workItemId": {
                "const": "V3-MIG-020"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceType": {
                "const": "M0_COMPLETION_RECORD"
              },
              "executions": {
                "maxItems": 1,
                "minItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "commandId": {
                        "const": "complete-pre-evidence-acceptance"
                      },
                      "command": {
                        "const": [
                          "bash",
                          "scripts/gates/full_quality.sh",
                          "--pre-evidence"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "description": "Final M0 record; a PASS is replayable rather than self-attesting.",
      "properties": {
        "schemaVersion": {
          "const": 2,
          "default": 2,
          "title": "Schemaversion",
          "type": "integer"
        },
        "workItemId": {
          "pattern": "^V3-MIG-0(?:1[6-9]|20)$",
          "title": "Workitemid",
          "type": "string"
        },
        "status": {
          "const": "FINAL",
          "default": "FINAL",
          "title": "Status",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Result",
          "type": "string"
        },
        "evidenceType": {
          "minLength": 3,
          "title": "Evidencetype",
          "type": "string"
        },
        "recordedAt": {
          "format": "date-time",
          "title": "Recordedat",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/EvidenceBinding"
        },
        "authorityDigests": {
          "$ref": "#/$defs/AuthorityDigests"
        },
        "executions": {
          "items": {
            "$ref": "#/$defs/EvidenceExecution"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Executions",
          "type": "array"
        },
        "evidenceInputs": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Evidenceinputs",
          "type": "object"
        },
        "truthBoundary": {
          "minLength": 12,
          "title": "Truthboundary",
          "type": "string"
        },
        "sourceMigrationAuthorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceMigrationAuthorization"
            },
            {
              "type": "null"
            }
          ]
        },
        "directMainAcceptanceReceipts": {
          "items": {
            "$ref": "#/$defs/DirectMainAcceptanceReceipt"
          },
          "title": "Directmainacceptancereceipts",
          "type": "array"
        },
        "recoveryRehearsalReceipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryRehearsalReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workItemId",
        "result",
        "evidenceType",
        "recordedAt",
        "binding",
        "authorityDigests",
        "executions",
        "truthBoundary",
        "sourceMigrationAuthorization",
        "directMainAcceptanceReceipts",
        "recoveryRehearsalReceipt"
      ],
      "title": "FinalMigrationEvidence",
      "type": "object"
    },
    "IndependentReceiptSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "keyId": {
          "minLength": 1,
          "title": "Keyid",
          "type": "string"
        },
        "value": {
          "minLength": 32,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "title": "IndependentReceiptSignature",
      "type": "object"
    },
    "PendingMigrationEvidence": {
      "additionalProperties": false,
      "description": "Explicitly incomplete record used while a final implementation tree is changing.",
      "properties": {
        "schemaVersion": {
          "const": 2,
          "default": 2,
          "title": "Schemaversion",
          "type": "integer"
        },
        "workItemId": {
          "pattern": "^V3-MIG-0(?:1[6-9]|20)$",
          "title": "Workitemid",
          "type": "string"
        },
        "status": {
          "const": "PENDING_FINALIZATION",
          "default": "PENDING_FINALIZATION",
          "title": "Status",
          "type": "string"
        },
        "finalizationCommand": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Finalizationcommand",
          "type": "array"
        },
        "reason": {
          "minLength": 12,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "workItemId",
        "finalizationCommand",
        "reason"
      ],
      "title": "PendingMigrationEvidence",
      "type": "object"
    },
    "RecoveryRehearsalReceipt": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "const": "INDEPENDENT_MACHINE_VERIFIER",
          "title": "Issuer",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "nonce": {
          "minLength": 16,
          "title": "Nonce",
          "type": "string"
        },
        "revocationEpoch": {
          "minimum": 0,
          "title": "Revocationepoch",
          "type": "integer"
        },
        "signature": {
          "$ref": "#/$defs/IndependentReceiptSignature"
        },
        "receiptType": {
          "const": "V3_1_RECOVERY_REHEARSAL",
          "title": "Receipttype",
          "type": "string"
        },
        "candidateSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Candidatesha",
          "type": "string"
        },
        "restoredExactSha": {
          "const": true,
          "title": "Restoredexactsha",
          "type": "boolean"
        },
        "outcome": {
          "const": "PASSED",
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "issuedAt",
        "expiresAt",
        "nonce",
        "revocationEpoch",
        "signature",
        "receiptType",
        "candidateSha",
        "restoredExactSha",
        "outcome"
      ],
      "title": "RecoveryRehearsalReceipt",
      "type": "object"
    },
    "RequiredCheckReceipt": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "TrainCapsule / Factory quality",
            "TrainCapsule / Packaging install",
            "TrainCapsule / Product contract",
            "TrainCapsule / Product unit",
            "TrainCapsule / Security",
            "TrainCapsule / Docs and schemas",
            "TrainCapsule / Source-of-truth integrity",
            "TrainCapsule / Source freshness"
          ],
          "title": "Name",
          "type": "string"
        },
        "conclusion": {
          "const": "success",
          "title": "Conclusion",
          "type": "string"
        },
        "observedSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Observedsha",
          "type": "string"
        }
      },
      "required": [
        "name",
        "conclusion",
        "observedSha"
      ],
      "title": "RequiredCheckReceipt",
      "type": "object"
    },
    "SourceMigrationAuthorization": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "const": "INDEPENDENT_MACHINE_VERIFIER",
          "title": "Issuer",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "nonce": {
          "minLength": 16,
          "title": "Nonce",
          "type": "string"
        },
        "revocationEpoch": {
          "minimum": 0,
          "title": "Revocationepoch",
          "type": "integer"
        },
        "signature": {
          "$ref": "#/$defs/IndependentReceiptSignature"
        },
        "receiptType": {
          "const": "V3_1_SOURCE_MIGRATION_AUTHORIZATION",
          "title": "Receipttype",
          "type": "string"
        },
        "candidateSha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Candidatesha",
          "type": "string"
        },
        "activeGenerationDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activegenerationdigest",
          "type": "string"
        },
        "sourceManifestDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcemanifestdigest",
          "type": "string"
        },
        "sourceGenerationDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcegenerationdigest",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "issuedAt",
        "expiresAt",
        "nonce",
        "revocationEpoch",
        "signature",
        "receiptType",
        "candidateSha",
        "activeGenerationDigest",
        "sourceManifestDigest",
        "sourceGenerationDigest"
      ],
      "title": "SourceMigrationAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Generated JSON Schema entry point for final and fail-closed pending records.",
  "discriminator": {
    "mapping": {
      "FINAL": "#/$defs/FinalMigrationEvidence",
      "PENDING_FINALIZATION": "#/$defs/PendingMigrationEvidence"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/FinalMigrationEvidence"
    },
    {
      "$ref": "#/$defs/PendingMigrationEvidence"
    }
  ],
  "title": "MigrationEvidenceDocument",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/migration-evidence.schema.json"
}
