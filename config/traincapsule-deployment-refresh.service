[Unit]
Description=TrainCapsule signed immutable runtime refresh broker
After=traincapsule-verifier-git-anchor-updater.service
ConditionPathExists=/etc/traincapsule-deployment/refresh-policy.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/traincapsule-deployment-refresh --apply --confirm APPLY_DEPLOYMENT_REFRESH
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/traincapsule-verifier/deployment-refresh-claims
ReadOnlyPaths=/var/lib/traincapsule-verifier/anchor-updates
ReadOnlyPaths=/var/lib/traincapsule-runtime/git
ReadWritePaths=/opt/traincapsule-runtime/generations
# The broker atomically creates/replaces the `current` directory entry. A
# bind-mount exception for the entry itself cannot work on a first install
# because systemd resolves ReadWritePaths before ExecStart and the entry does
# not exist yet. Grant the root-only broker its runtime parent instead; all
# candidate bytes remain independently inventory-checked before the swap.
ReadWritePaths=/opt/traincapsule-runtime
# Repository replacement is a sibling-stage-and-rename transaction, so the
# broker needs the boundary's parent directory writable. The independently
# signed inputs remain read-only and private/oracle authority stays hidden.
ReadWritePaths=/var/lib/traincapsule-verifier
InaccessiblePaths=/var/lib/traincapsule-verifier/private
InaccessiblePaths=/var/lib/traincapsule-verifier/oracle
ReadWritePaths=/var/lib/traincapsule-verifier/deployment-refresh-journal
ReadWritePaths=/etc/traincapsule-controller
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
UMask=0077
