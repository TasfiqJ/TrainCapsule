{
  "additionalProperties": false,
  "properties": {
    "anchorVersion": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Anchorversion",
      "type": "integer"
    },
    "authorityId": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "title": "Authorityid",
      "type": "string"
    },
    "issuerId": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Issuerid",
      "type": "string"
    },
    "keyId": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Keyid",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "currentRevocationDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Currentrevocationdigest",
      "type": "string"
    },
    "previousRevocationDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previousrevocationdigest"
    },
    "issuedAt": {
      "format": "date-time",
      "title": "Issuedat",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    }
  },
  "required": [
    "authorityId",
    "issuerId",
    "keyId",
    "epoch",
    "currentRevocationDigest",
    "previousRevocationDigest",
    "issuedAt",
    "expiresAt"
  ],
  "title": "ExternalEvidenceAuthorityAnchor",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/external-evidence-authority-anchor.schema.json"
}
