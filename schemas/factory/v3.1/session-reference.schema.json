{
  "$defs": {
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "STARTED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "SessionState",
      "type": "string"
    }
  },
  "$id": "https://traincapsule.local/schemas/factory/v3.1/session-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endedat"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "sessionId": {
      "$ref": "#/$defs/Identifier"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SessionState"
    },
    "taskPacketDigest": {
      "$ref": "#/$defs/Digest"
    },
    "transcriptDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workItemId": {
      "pattern": "^V3-[A-Z]+-[0-9]{3}$",
      "title": "Workitemid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "workItemId",
    "provider",
    "backend",
    "taskPacketDigest",
    "state",
    "startedAt"
  ],
  "title": "SessionReferenceV31",
  "type": "object"
}
