{
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 3,
      "default": 3,
      "title": "Version",
      "type": "integer"
    },
    "schemaId": {
      "const": "traincapsule.private-gate-receipt/v3",
      "default": "traincapsule.private-gate-receipt/v3",
      "title": "Schemaid",
      "type": "string"
    },
    "receiptId": {
      "pattern": "^PGATE-[A-Z0-9_-]{8,96}$",
      "title": "Receiptid",
      "type": "string"
    },
    "candidateSha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidatesha",
      "type": "string"
    },
    "workItemId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workitemid",
      "type": "string"
    },
    "suite": {
      "const": "full-release",
      "default": "full-release",
      "title": "Suite",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Scope",
      "type": "array"
    },
    "runnerDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runnerdigest",
      "type": "string"
    },
    "runnerVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Runnerversion",
      "type": "string"
    },
    "resultDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Resultdigest",
      "type": "string"
    },
    "decision": {
      "const": "PASSED",
      "default": "PASSED",
      "title": "Decision",
      "type": "string"
    },
    "issuedAt": {
      "format": "date-time",
      "title": "Issuedat",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "signatureAlgorithm": {
      "const": "ed25519",
      "default": "ed25519",
      "title": "Signaturealgorithm",
      "type": "string"
    },
    "keyId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Keyid",
      "type": "string"
    }
  },
  "required": [
    "receiptId",
    "candidateSha",
    "workItemId",
    "scope",
    "runnerDigest",
    "runnerVersion",
    "resultDigest",
    "issuedAt",
    "expiresAt",
    "keyId"
  ],
  "title": "PrivateGateReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/private-gate-receipt.schema.json"
}
