        "items": {
          "$ref": "#/$defs/EvidenceType"
        },
        "type": "array"
      },
      "propertyNames": {
        "$ref": "#/$defs/CommercialMaturity"
      },
      "title": "Evidencerequirements",
      "type": "object"
    }
  },
  "required": [
    "syntheticEvidenceMayAdvance",
    "repositoryAuthoredReceiptsAreTrusted",
    "evidenceRequirements"
  ],
  "title": "CommercialMaturityConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
