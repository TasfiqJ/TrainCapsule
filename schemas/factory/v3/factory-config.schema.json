{
  "$defs": {
    "ExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "maxConcurrentMutatingSessions": {
          "maximum": 4,
          "minimum": 1,
          "title": "Maxconcurrentmutatingsessions",
          "type": "integer"
        },
        "maxConcurrentReadOnlySessions": {
          "maximum": 8,
          "minimum": 1,
          "title": "Maxconcurrentreadonlysessions",
          "type": "integer"
        },
        "workUntilDone": {
          "const": false,
          "title": "Workuntildone",
          "type": "boolean"
        },
        "checkpointEveryStage": {
          "const": true,
          "title": "Checkpointeverystage",
          "type": "boolean"
        },
        "preserveCandidateOnFailure": {
          "const": true,
          "title": "Preservecandidateonfailure",
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "maxConcurrentMutatingSessions",
        "maxConcurrentReadOnlySessions",
        "workUntilDone",
        "checkpointEveryStage",
        "preserveCandidateOnFailure"
      ],
      "title": "ExecutionPolicy",
      "type": "object"
    },
    "OperatorPolicy": {
      "additionalProperties": false,
      "properties": {
        "zeroHumanOperation": {
          "const": true,
          "title": "Zerohumanoperation",
          "type": "boolean"
        },
        "policyGateMode": {
          "const": "deterministic_machine_policy",
          "title": "Policygatemode",
          "type": "string"
        },
        "ownerDirectedDeviationRecord": {
          "minLength": 1,
          "title": "Ownerdirecteddeviationrecord",
          "type": "string"
        },
        "externalTruthRemainsReceiptBound": {
          "const": true,
          "title": "Externaltruthremainsreceiptbound",
          "type": "boolean"
        },
        "syntheticCommercialEvidenceForbidden": {
          "const": true,
          "title": "Syntheticcommercialevidenceforbidden",
          "type": "boolean"
        }
      },
      "required": [
        "zeroHumanOperation",
        "policyGateMode",
        "ownerDirectedDeviationRecord",
        "externalTruthRemainsReceiptBound",
        "syntheticCommercialEvidenceForbidden"
      ],
      "title": "OperatorPolicy",
      "type": "object"
    },
    "ReleasePolicy": {
      "additionalProperties": false,
      "properties": {
        "publicationBranch": {
          "const": "main",
          "title": "Publicationbranch",
          "type": "string"
        },
        "nonMainPushesForbidden": {
          "const": true,
          "title": "Nonmainpushesforbidden",
          "type": "boolean"
        },
        "pullRequestDependencyForbidden": {
          "const": true,
          "title": "Pullrequestdependencyforbidden",
          "type": "boolean"
        },
        "monitorHostedMainChecks": {
          "const": true,
          "title": "Monitorhostedmainchecks",
          "type": "boolean"
        },
        "automaticRevertAndQuarantine": {
          "const": true,
          "title": "Automaticrevertandquarantine",
          "type": "boolean"
        },
        "requireCandidateShaMatch": {
          "const": true,
          "title": "Requirecandidateshamatch",
          "type": "boolean"
        }
      },
      "required": [
        "publicationBranch",
        "nonMainPushesForbidden",
        "pullRequestDependencyForbidden",
        "monitorHostedMainChecks",
        "automaticRevertAndQuarantine",
        "requireCandidateShaMatch"
      ],
      "title": "ReleasePolicy",
      "type": "object"
    },
    "RepositoryPolicy": {
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "const": "main",
          "title": "Basebranch",
          "type": "string"
        },
        "releaseMode": {
          "const": "owner_directed_main_only",
          "title": "Releasemode",
          "type": "string"
        },
        "directMainPush": {
          "const": true,
          "title": "Directmainpush",
          "type": "boolean"
        },
        "requireCleanBase": {
          "title": "Requirecleanbase",
          "type": "boolean"
        },
        "candidateManifestRequired": {
          "const": true,
          "title": "Candidatemanifestrequired",
          "type": "boolean"
        }
      },
      "required": [
        "baseBranch",
        "releaseMode",
        "directMainPush",
        "requireCleanBase",
        "candidateManifestRequired"
      ],
      "title": "RepositoryPolicy",
      "type": "object"
    },
    "RoadmapPolicy": {
      "additionalProperties": false,
      "properties": {
        "milestones": {
          "title": "Milestones",
          "type": "string"
        },
        "workItems": {
          "title": "Workitems",
          "type": "string"
        },
        "dispositions": {
          "title": "Dispositions",
          "type": "string"
        },
        "legacyMap": {
          "title": "Legacymap",
          "type": "string"
        },
        "completionMode": {
          "const": "milestone",
          "title": "Completionmode",
          "type": "string"
        },
        "expansionMode": {
          "const": "proposal_only",
          "title": "Expansionmode",
          "type": "string"
        }
      },
      "required": [
        "milestones",
        "workItems",
        "dispositions",
        "legacyMap",
        "completionMode",
        "expansionMode"
      ],
      "title": "RoadmapPolicy",
      "type": "object"
    },
    "RuntimePolicy": {
      "additionalProperties": false,
      "properties": {
        "localStateRootEnvironmentVariable": {
          "minLength": 1,
          "title": "Localstaterootenvironmentvariable",
          "type": "string"
        },
        "singleInstanceLock": {
          "const": true,
          "title": "Singleinstancelock",
          "type": "boolean"
        },
        "hardStuckFile": {
          "const": "HARD_STUCK.json",
          "title": "Hardstuckfile",
          "type": "string"
        },
        "stopFile": {
          "const": "STOP",
          "title": "Stopfile",
          "type": "string"
        },
        "migrationCompleteMarker": {
          "const": "MIGRATION_COMPLETE_V3.json",
          "title": "Migrationcompletemarker",
          "type": "string"
        },
        "supervisorStateFile": {
          "const": "supervisor-state.json",
          "title": "Supervisorstatefile",
          "type": "string"
        },
        "supervisorLockFile": {
          "const": "supervisor.lock",
          "title": "Supervisorlockfile",
          "type": "string"
        },
        "redactSecrets": {
          "const": true,
          "title": "Redactsecrets",
          "type": "boolean"
        },
        "rawCustomerEvidenceInRepository": {
          "const": false,
          "title": "Rawcustomerevidenceinrepository",
          "type": "boolean"
        }
      },
      "required": [
        "localStateRootEnvironmentVariable",
        "singleInstanceLock",
        "hardStuckFile",
        "stopFile",
        "migrationCompleteMarker",
        "supervisorStateFile",
        "supervisorLockFile",
        "redactSecrets",
        "rawCustomerEvidenceInRepository"
      ],
      "title": "RuntimePolicy",
      "type": "object"
    },
    "SourceOfTruthPolicy": {
      "additionalProperties": false,
      "properties": {
        "activeBundle": {
          "title": "Activebundle",
          "type": "string"
        },
        "manifest": {
          "title": "Manifest",
          "type": "string"
        },
        "contextIndex": {
          "title": "Contextindex",
          "type": "string"
        },
        "integrityGate": {
          "title": "Integritygate",
          "type": "string"
        }
      },
      "required": [
        "activeBundle",
        "manifest",
        "contextIndex",
        "integrityGate"
      ],
      "title": "SourceOfTruthPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": 3,
      "maximum": 3,
      "minimum": 3,
      "title": "Version",
      "type": "integer"
    },
    "allowPaidUsage": {
      "const": false,
      "default": false,
      "title": "Allowpaidusage",
      "type": "boolean"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryPolicy"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionPolicy"
    },
    "sourceOfTruth": {
      "$ref": "#/$defs/SourceOfTruthPolicy"
    },
    "roadmap": {
      "$ref": "#/$defs/RoadmapPolicy"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimePolicy"
    },
    "release": {
      "$ref": "#/$defs/ReleasePolicy"
    },
    "operatorPolicy": {
      "$ref": "#/$defs/OperatorPolicy"
    }
  },
  "required": [
    "repository",
    "execution",
    "sourceOfTruth",
    "roadmap",
    "runtime",
    "release",
    "operatorPolicy"
  ],
  "title": "FactoryV3Config",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traincapsule.local/schemas/factory/v3/factory-config.schema.json"
}
