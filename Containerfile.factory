FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bubblewrap ca-certificates curl git jq nodejs npm ripgrep socat \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /workspace
COPY pyproject.toml ./
RUN uv sync --extra dev --no-install-project

COPY tcfactory ./tcfactory
COPY config ./config
COPY prompts ./prompts
COPY schemas ./schemas
COPY scripts ./scripts
COPY CLAUDE.md README.md ./
RUN uv sync --extra dev

# Mount the actual TrainCapsule repository/worktrees separately. Never mount the host Docker socket.
CMD ["uv", "run", "tcfactory", "doctor"]
